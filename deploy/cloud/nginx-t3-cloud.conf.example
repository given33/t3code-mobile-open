# Inside the EXISTING stream map for $sni_443_backend, add only this entry:
# mobile.example.invalid  127.0.0.1:18374;
# Install only the block below in a new stream.d include. Do not add another :443 listener.
server {
    listen 127.0.0.1:18374 proxy_protocol;
    tcp_nodelay on;
    proxy_socket_keepalive on;
    proxy_connect_timeout 5s;
    proxy_timeout 1h;
    proxy_pass 127.0.0.1:18372;
}
